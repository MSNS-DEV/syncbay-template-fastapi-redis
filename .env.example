# Copy to .env for local runs. docker compose reads APP_PORT and the overrides below from it.

# Host port for `docker compose up` (the container listens on 8000).
APP_PORT=15100
# Port uvicorn listens on inside the container / when run locally.
PORT=8000

# PostgreSQL connection URL. postgresql:// is converted to postgresql+asyncpg:// automatically;
# ?sslmode=require is supported. Compose sets this to its own postgres service.
DATABASE_URL=postgresql://notes:notes@localhost:5432/notes
# Redis connection URL (redis:// or rediss://). Compose sets this to its own redis service.
REDIS_URL=redis://localhost:6379/0

# HS256 signing key for access and refresh tokens, at least 32 characters.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=local-dev-only-secret-change-me-0123456789abcdef

# Access token lifetime in seconds (default 15 minutes).
ACCESS_TOKEN_TTL_SECONDS=900
# Refresh token lifetime in seconds (default 14 days).
REFRESH_TOKEN_TTL_SECONDS=1209600

# Requests per minute per client IP to register / login / refresh.
RATE_LIMIT_AUTH_PER_MINUTE=10
# Note writes (create / update / delete) per minute per user.
RATE_LIMIT_WRITE_PER_MINUTE=60
# How long a cached note list page lives in Redis, in seconds.
CACHE_TTL_SECONDS=60

# Number of reverse proxies in front of the app that append to X-Forwarded-For.
# 0 = use the TCP peer address (local compose). On Syncbay use 1.
TRUSTED_PROXY_HOPS=0
# Set the Secure flag on auth cookies. Browsers accept Secure cookies on http://localhost.
COOKIE_SECURE=true
# SQLAlchemy connection pool size (one uvicorn worker).
DB_POOL_SIZE=5
# debug | info | warning | error
LOG_LEVEL=info

# Give every new account three welcome notes.
SEED_DEMO_DATA=true

# Branding: name in the header, optional logo URL, primary colour (hex).
BRAND_NAME=Syncbay
BRAND_LOGO_URL=
BRAND_PRIMARY=#06b6d4
